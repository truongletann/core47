# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# opennext / cloudflare build output (regenerated by `npm run deploy`)
/.open-next/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# wrangler / cloudflare local dev state (contains local D1/R2 data, may include real secrets entered during local testing)
.wrangler/

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code local-only permission overrides (personal, not shared config)
.claude/settings.local.json
